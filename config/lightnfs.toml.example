[server]
reactors = 0
offload_threads = 16
# offload_heavy_threads = 0   # threads reserved for fsync/fallocate/copy-grade jobs;
#                             # 0 = max(1, offload_threads/4)
# offload_queue_cap = 4096    # per-class queued-job cap before admissions wait
# ring = "auto"               # auto | uring | epoll (auto probes io_uring, falls back)
# ring_sqpoll = false         # io_uring SQPOLL kernel-thread submission
# state_shards = 16           # v4 client/session/state table shard count
# bind = ""                   # listen address literal (v4 or v6); empty = all
                              # interfaces, dual-stack
port = 2049
mount_port = 20048
rpcbind = true
builtin_portmap = false
state_dir = "/tmp/lightnfs-state"
max_connections = 4096
per_peer_limit = 128
max_request_size = "2MiB"
# ctl_socket = "/run/lightnfs/ctl.sock"   # default: <state_dir>/ctl.sock
metrics_port = 0                          # Prometheus text endpoint; 0 = disabled
# metrics_bind = "127.0.0.1"              # metrics bind address; loopback by default
# metrics_allow = ["10.0.0.0/8"]          # CIDR allowlist; empty = bind address only
# server_owner = ""                       # RFC 8881 server_owner.major_id; default
# server_scope = ""                       #   derives from hostname + state_dir
log_level = "info"  # debug | info | warn | error; debug adds a per-request summary line
                    # (with it off, recent error replies stay visible via
                    # `lightnfs-ctl dump-errors`)
# slow_request_ms = 1000  # requests slower than this warn-log a per-op time breakdown;
#                         # 0 disables the slow-request log
# error_ring = 64         # entries kept in the `lightnfs-ctl dump-errors` sampling ring
# log_file = ""                    # empty = stderr; otherwise a size-rotated file
# log_rotate_size = "50MiB"        # rotate when the log file reaches this size
# log_rotate_keep = 5              # rotated files kept (file.1 .. file.N)
#
# Hot reload (SIGHUP or `lightnfs-ctl reload`): log_level, slow_request_ms,
# error_ring, per-export clients + QoS, and [limits] client_* apply live; every other
# key needs a restart (the reload report says which).

[protocol]
v3 = true
v4 = true
lease = "90s"            # v4.1 lease
# grace = "auto"         # reclaim window after restart; "auto" = lease. Operators
                         # often set grace < lease for faster restart recovery.
courtesy_multiplier = 24 # expired clients are kept (courtesy) up to 24 × lease
                         # unless a conflicting OPEN reclaims them first
drc_ttl = "120s"    # duplicate request cache entry lifetime
drc_mem = "64MiB"   # duplicate request cache memory cap

[limits]
inflight_per_conn = 64
# Per-client (v4 clientid) token buckets; 0 / omitted = unlimited. Hot-reloadable.
# client_read_bps = "0"    # e.g. "50MiB"
# client_write_bps = "0"
# client_iops = 0

[[export]]
path = "/tmp" # replace with the directory to export
backend = "local"
fsid = 1
clients = ["192.168.0.0/24", "127.0.0.0/8"]
squash = "root"
readonly = true     # phase 2: set false for read-write exports
# Per-export token buckets (READ/WRITE data path); 0 / omitted = unlimited.
# Hot-reloadable via SIGHUP / `lightnfs-ctl reload`.
# read_bps = "0"     # e.g. "200MiB"
# write_bps = "0"
# iops = 0

[export.local]
handles = "auto"
fd_cache = 4096
readdir_enrich = true
# identity = "check"   # check (default) | strict (faccessat2 confirm) | setfsuid (root only)
