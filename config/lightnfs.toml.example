[server]
reactors = 0
offload_threads = 16
# offload_heavy_threads = 0   # threads reserved for fsync/fallocate/copy-grade jobs;
#                             # 0 = max(1, offload_threads/4)
# offload_queue_cap = 4096    # per-class queued-job cap before admissions wait
# ring = "auto"               # auto | uring | epoll (auto probes io_uring, falls back)
# ring_sqpoll = false         # io_uring SQPOLL kernel-thread submission
# state_shards = 16           # v4 client/session/state table shard count
# bind = ""                   # listen address literal (v4 or v6); empty = all
                              # interfaces, dual-stack
port = 2049
mount_port = 20048
rpcbind = true
builtin_portmap = false
state_dir = "/tmp/lightnfs-state"
max_connections = 4096
per_peer_limit = 128
max_request_size = "2MiB"
# ctl_socket = "/run/lightnfs/ctl.sock"   # default: <state_dir>/ctl.sock
metrics_port = 0                          # Prometheus text endpoint; 0 = disabled
# metrics_bind = "127.0.0.1"              # metrics bind address; loopback by default
# metrics_allow = ["10.0.0.0/8"]          # CIDR allowlist; empty = bind address only
# server_owner = ""                       # RFC 8881 server_owner.major_id; default
# server_scope = ""                       #   derives from hostname + state_dir
log_level = "info"  # debug | info | warn | error; debug adds a per-request summary line
                    # (with it off, recent error replies stay visible via
                    # `lightnfs-ctl dump-errors`)
# slow_request_ms = 1000  # requests slower than this warn-log a per-op time breakdown;
#                         # 0 disables the slow-request log
# error_ring = 64         # entries kept in the `lightnfs-ctl dump-errors` sampling ring
# log_file = ""                    # empty = stderr; otherwise a size-rotated file
# log_rotate_size = "50MiB"        # rotate when the log file reaches this size
# log_rotate_keep = 5              # rotated files kept (file.1 .. file.N)
#
# Hot reload (SIGHUP or `lightnfs-ctl reload`): log_level, slow_request_ms,
# error_ring, per-export clients + QoS, and [limits] client_* apply live; every other
# key needs a restart (the reload report says which).

[protocol]
v3 = true
v4 = true
# delegations = true  # v4.1 read delegations (granted only to sessions that bound a
#                     # backchannel); set false to disable granting entirely
lease = "90s"            # v4.1 lease
# grace = "auto"         # reclaim window after restart; "auto" = lease. Operators
                         # often set grace < lease for faster restart recovery.
courtesy_multiplier = 24 # expired clients are kept (courtesy) up to 24 × lease
                         # unless a conflicting OPEN reclaims them first
drc_ttl = "120s"    # duplicate request cache entry lifetime
drc_mem = "64MiB"   # duplicate request cache memory cap

[limits]
inflight_per_conn = 64
# Per-client (v4 clientid) token buckets; 0 / omitted = unlimited. Hot-reloadable.
# client_read_bps = "0"    # e.g. "50MiB"
# client_write_bps = "0"
# client_iops = 0

# RPC-over-TLS (RFC 9289): opportunistic transport encryption negotiated with a client
# AUTH_TLS probe on the NULL procedure ("xprtsec=tls" on Linux 6.x mounts).  "TLS 保通道、
# AUTH_SYS 报身份": TLS authenticates+encrypts the channel while AUTH_SYS still declares
# the user.  Requires a build with OpenSSL.  Applying a changed [tls] needs a restart.
# [tls]
# mode = "off"             # off (default) | optional (offer STARTTLS, still serve
#                          # cleartext) | required (offer STARTTLS, refuse cleartext ops)
# cert = "/etc/lightnfs/tls/server.pem"   # PEM certificate chain
# key  = "/etc/lightnfs/tls/server.key"   # PEM private key
# ca   = "/etc/lightnfs/tls/clients-ca.pem"  # optional: verify client certs against this
# client_cert = false      # require a client certificate (mutual TLS; needs `ca`)

[[export]]
path = "/tmp" # replace with the directory to export
backend = "local"
fsid = 1
clients = ["192.168.0.0/24", "127.0.0.0/8"]
squash = "root"
readonly = true     # phase 2: set false for read-write exports
# Per-export token buckets (READ/WRITE data path); 0 / omitted = unlimited.
# Hot-reloadable via SIGHUP / `lightnfs-ctl reload`.
# read_bps = "0"     # e.g. "200MiB"
# write_bps = "0"
# iops = 0

[export.local]
handles = "auto"
fd_cache = 4096
readdir_enrich = true
# identity = "check"   # check (default) | strict (faccessat2 confirm) | setfsuid (root only)

# GlusterFS export (plan doc 10 §5.3): the tree lives in the volume, `path` is only the
# name clients mount.  libgfapi.so.0 is loaded at runtime (glusterfs-common / libgfapi0);
# every libgfapi call runs on the offload pool, so offload_threads bounds throughput.
# [[export]]
# path = "/gluster"
# backend = "gluster"
# fsid = 2
# clients = ["192.168.0.0/24"]
# squash = "none"          # identities pass through to the bricks (kNativeAccess)
# readonly = false
#
# [export.gluster]
# volume = "vol0"
# servers = "gs1,gs2:24007"   # volfile servers, tried in order; host[:port] or [v6]:port
# subdir = "/exports/a"       # export root inside the volume (default "/")
# transport = "tcp"           # tcp | rdma | unix
# log_file = ""               # libgfapi log; empty = its default (often unwritable unprivileged)
# log_level = 4               # gluster levels 0..9 (4 = ERROR, 7 = INFO)
# fd_cache = 1024             # anonymous-IO glfd cache and object-handle cache capacity
# readdir_enrich = true       # xreaddirplus with stat + handle (READDIRPLUS without lookups)
# jukebox = true              # transport errors → JUKEBOX/DELAY (client retries); false → EIO
# native_locks = true         # push v4 byte-range locks into the volume (posix-locks)

# CephFS export (design 06 §6.8): the tree lives in the filesystem, `path` is only the
# name clients mount.  libcephfs.so.2 is loaded at runtime (libcephfs2); every call runs on
# the offload pool.  The first backend with both a native change counter (stx_version →
# change_attr_type = MONOTONIC_INCR) and native byte-range locks (MDS-arbitrated), i.e.
# both halves of multi-gateway coherence.
# [[export]]
# path = "/cephfs"
# backend = "cephfs"
# fsid = 4
# clients = ["192.168.0.0/24"]
# squash = "none"          # identities are handed to libcephfs as the UserPerm of every call
# readonly = false
#
# [export.cephfs]
# conf = "/etc/ceph/ceph.conf"   # empty = library default search ($CEPH_CONF, /etc/ceph/ceph.conf)
# id = "lightnfs"                # client id (without "client."); its MDS caps must cover subdir
# keyring = "/etc/ceph/ceph.client.lightnfs.keyring"
# mon_host = "mon1,mon2,mon3"    # overrides ceph.conf; empty = from ceph.conf
# fs_name = "cephfs"             # empty = the cluster's default filesystem
# subdir = "/exports/a"          # export root inside the filesystem (default "/")
# log_file = ""                  # libcephfs log; empty = its default
# options = "client_mount_timeout=30"   # extra ceph_conf_set pairs, comma separated
# fd_cache = 1024                # anonymous-IO Fh cache and inode-handle cache capacity
# readdir_enrich = true          # readdirplus attributes + handles (READDIRPLUS without lookups)
# jukebox = true                 # transport errors → JUKEBOX/DELAY (client retries); false → EIO
# native_locks = true            # push v4 byte-range locks to the MDS (ceph_ll_setlk)

# Lustre export (design 06 §6.5): `path` is a directory inside a Lustre client mount.
# Filehandles are FIDs (opened back through <mount>/.lustre/fid, no CAP_DAC_READ_SEARCH
# needed); IO, caches and identity modes are the local backend's.  No liblustreapi is
# required — the backend talks to the kernel client with ioctls.
# [[export]]
# path = "/mnt/lustre/projects"
# backend = "lustre"
# fsid = 3
# clients = ["10.0.0.0/8"]
# squash = "none"
#
# [export.lustre]
# mount = "/mnt/lustre"       # Lustre mount root; default: detected (walk up while st_dev matches)
# fd_cache = 4096             # data-fd / O_PATH resolve cache capacity (same knob as local)
# identity = "check"          # check | strict | setfsuid (root only; MDS-side authorization)
# readdir_enrich = true       # READDIRPLUS attrs + FID handles without per-entry lookups
# hsm = true                  # HSM-released files: kick RESTORE, answer JUKEBOX/DELAY (false: block inline)
# native_locks = true         # v4 byte-range locks as OFD fcntl locks (MDS-coherent with `-o flock`)
