# lightnfs — least-privilege NFS gateway unit (security checklist §8.5 item 7).
#
# Runs as a dedicated unprivileged user with only the two capabilities the design
# requires: CAP_DAC_READ_SEARCH (open_by_handle_at for stable filehandles, design 06)
# and CAP_NET_BIND_SERVICE (bind port 2049/20048).  Everything else is dropped and a
# seccomp allowlist restricts the syscall surface to the io_uring + filesystem set the
# server actually issues (derived from an strace of a full v3+v4 run; see
# scripts/gen_seccomp_allowlist.sh).
#
# Install: adjust User/Group and the paths, then
#   sudo cp packaging/systemd/lightnfs.service /etc/systemd/system/
#   sudo systemd-analyze security lightnfs.service   # audit the sandbox
#   sudo systemctl enable --now lightnfs

[Unit]
Description=lightnfs NFS gateway
Documentation=https://github.com/locallocal/lightnfs
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/bin/lightnfsd --config /etc/lightnfs/lightnfs.toml
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=2

# --- identity: a dedicated system user owns nothing it exports ---
User=lightnfs
Group=lightnfs
# Create with:  sudo useradd --system --home /var/lib/lightnfs --shell /usr/sbin/nologin lightnfs

# --- capabilities: exactly the two the design needs, nothing inheritable else ---
AmbientCapabilities=CAP_DAC_READ_SEARCH CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_DAC_READ_SEARCH CAP_NET_BIND_SERVICE
NoNewPrivileges=yes

# --- filesystem: read-only system, private everything, only state_dir writable ---
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/lightnfs
StateDirectory=lightnfs
RuntimeDirectory=lightnfs
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes
# NOTE: the exports themselves live outside ProtectSystem — add each exported tree as an
# additional ReadWritePaths= (or ReadOnlyPaths= for readonly exports), e.g.:
#   ReadWritePaths=/srv/export

# --- network: IP only ---
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
IPAddressAllow=any

# --- seccomp: architectures + syscall allowlist ---
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@clock @debug @module @mount @obsolete @raw-io @reboot @swap @cpu-emulation
# io_uring is required (the runtime is uring-native) and is NOT in @system-service on
# older systemd; add it (and the file-handle syscalls) explicitly:
SystemCallFilter=io_uring_setup io_uring_enter io_uring_register
SystemCallFilter=name_to_handle_at open_by_handle_at
SystemCallErrorNumber=EPERM

# --- resource ceilings (belt-and-braces over the in-process limits) ---
LimitNOFILE=1048576
TasksMax=4096

[Install]
WantedBy=multi-user.target
